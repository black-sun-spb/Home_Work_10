# =========================
# Django Settings
# =========================

# Секретный ключ Django (сгенерировать свой!)
SECRET_KEY=django-insecure-your-secret-key

# Режим отладки (True или False)
DEBUG=True

# Список разрешенных хостов через запятую
ALLOWED_HOSTS=127.0.0.1,localhost,158.160.182.105


# =========================
# Database (PostgreSQL)
# =========================

# Имя базы данных
DB_NAME=home_work_10

# Пользователь базы данных
DB_USER=postgres

# Пароль базы данных
DB_PASSWORD=postgres_password

# Хост базы данных (для Docker-сети: имя сервиса из docker-compose)
DB_HOST=db

# Порт базы данных
DB_PORT=5432


# =========================
# Redis (Celery)
# =========================

# URL для брокера и результата Celery
REDIS_URL=redis://redis:6379/0


# =========================
# Stripe (если нужен)
# =========================

# API ключ Stripe
STRIPE_API_KEY=sk_test_your_key_here
